# PulseOps environment variables — copy to .env and fill in values
# .env is git-ignored; never commit real credentials.

# ── Strands Decider ──────────────────────────────────────────────────────────
# Override the default endpoint (http://127.0.0.1:8099)
# STRANDS_DECIDER_URL=http://127.0.0.1:8099

# HuggingFace checkpoint to serve
# CHECKPOINT=StrandsAgents/strands-decider-2B-qwen3.5-v1-2610

# ── AWS / Amazon Bedrock ─────────────────────────────────────────────────────
# Required for live Bedrock assessment. Without these, PulseOps uses a
# clearly-labelled placeholder and the rest of the demo still works.
AWS_ACCESS_KEY_ID=your_key_here
AWS_SECRET_ACCESS_KEY=your_secret_here
AWS_DEFAULT_REGION=us-east-1

# Bedrock model ID for assessment generation
# Cross-region inference profiles include the region prefix:
BEDROCK_MODEL_ID=us.amazon.nova-lite-v1:0

# ── Server ports ─────────────────────────────────────────────────────────────
PORT=8080
DECIDER_PORT=8099
