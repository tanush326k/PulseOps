# PulseOps environment variables — copy to .env and fill in real values.
# .env is git-ignored; never commit real credentials.

# ── Assessment provider ───────────────────────────────────────────────────────
# "mock"   → self-contained demo, no AWS credentials needed (default)
# "bedrock" → live Amazon Bedrock via strands-agents (requires AWS credentials below)
ASSESSMENT_PROVIDER=mock

# ── Strands Decider ──────────────────────────────────────────────────────────
# Override the default endpoint (http://127.0.0.1:8099)
# STRANDS_DECIDER_URL=http://127.0.0.1:8099

# HuggingFace checkpoint to serve
# CHECKPOINT=StrandsAgents/strands-decider-2B-qwen3.5-v1-2610

# ── AWS / Amazon Bedrock (only needed when ASSESSMENT_PROVIDER=bedrock) ───────
# Set these to real values; never commit this file once filled in.
# AWS_ACCESS_KEY_ID=<your IAM access key id>
# AWS_SECRET_ACCESS_KEY=<your IAM secret access key>
# AWS_DEFAULT_REGION=us-east-1

# Bedrock model ID for assessment generation
# Cross-region inference profiles include the region prefix:
# BEDROCK_MODEL_ID=us.amazon.nova-lite-v1:0

# ── Server ports & Network ──────────────────────────────────────────────────
PORT=8080
DECIDER_PORT=8099
# Default to local loopback (127.0.0.1). Never expose to the public internet without an auth proxy.
HOST=127.0.0.1
# Restrict CORS to specific origins (defaults to localhost/127.0.0.1)
# PULSEOPS_CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
